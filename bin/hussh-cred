#!/usr/bin/env bash
# hussh-cred — manage the in-RAM TACACS credential.
#
#   hussh-cred status            -> "locked" | "unlocked <seconds-left>"
#   hussh-cred unlock <minutes>  -> reads password from STDIN, caches it
#   hussh-cred lock              -> wipes it immediately
#
# The password is read from stdin (never argv, so it cannot appear in
# /proc/<pid>/cmdline or your shell history) and stored in the kernel user
# keyring with a hard expiry. Reboot, logout, or expiry all clear it.

set -euo pipefail
KEY_DESC="hussh:tacacs"

cmd="${1:-status}"

case "$cmd" in
  status)
    if id="$(keyctl search @u user "$KEY_DESC" 2>/dev/null)"; then
      hex="$(printf '%08x' "$id")"
      ttl="$(awk -v k="$hex" '$1 == k {print $4; exit}' /proc/keys 2>/dev/null || true)"
      echo "unlocked ${ttl:-?}"
    else
      echo "locked"
    fi
    ;;

  unlock)
    # The hold window must be a sane positive integer. Three failure modes
    # in the previous version, all of which defeat the security model:
    #   "0"    -> keyctl timeout 0 means NO expiry: the password stays in
    #             the keyring until logout. The whole point is self-expiry.
    #   "-5"   -> a negative value wraps to a ~135-year timeout.
    #   "abc"  -> $(( )) on a non-numeric string aborts under `set -u`,
    #             AFTER the key was already added, leaving it permanent.
    # Validate BEFORE touching the keyring, so a bad argument can never
    # leave a credential cached without an expiry.
    mins="${2:-60}"
    if [[ ! "$mins" =~ ^[0-9]+$ ]]; then
      echo "unlock: minutes must be a positive integer (got '$mins')" >&2
      exit 2
    fi
    if (( mins < 1 || mins > 1440 )); then
      echo "unlock: minutes must be between 1 and 1440 (got $mins)" >&2
      exit 2
    fi
    # Read the secret from stdin; strip a single trailing newline only.
    IFS= read -r -s secret || true
    if [[ -z "$secret" ]]; then
      echo "empty password, nothing cached" >&2
      exit 1
    fi
    # Revoke any previous copy first.
    if old="$(keyctl search @u user "$KEY_DESC" 2>/dev/null)"; then
      keyctl revoke "$old" 2>/dev/null || true
    fi
    id="$(printf '%s' "$secret" | keyctl padd user "$KEY_DESC" @u)"
    unset secret
    # If the timeout cannot be applied, the key must not survive: a cached
    # credential that never expires is worse than no cache at all.
    if ! keyctl timeout "$id" $(( mins * 60 )); then
      keyctl revoke "$id" 2>/dev/null || true
      echo "could not set expiry; credential discarded" >&2
      exit 1
    fi
    echo "cached for ${mins}m"
    ;;

  lock)
    if id="$(keyctl search @u user "$KEY_DESC" 2>/dev/null)"; then
      keyctl revoke "$id"
      echo "locked"
    else
      echo "already locked"
    fi
    ;;

  *)
    echo "usage: hussh-cred {status|unlock <minutes>|lock}" >&2
    exit 2
    ;;
esac
